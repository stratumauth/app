<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0-android37.0</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <ApplicationId>com.stratumauth.app</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);XA4218</MSBuildWarningsAsMessages>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
        <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
        <RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <TrimmerRootDescription>trim.xml</TrimmerRootDescription>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <NoWarn>$(NoWarn);IL2026;IL2104</NoWarn>
        <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
        <AndroidLinkTool>r8</AndroidLinkTool>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.3.4" />
        <PackageReference Include="DotNext.Threading" Version="6.11.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100-rc.3.26522.148">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
        <PackageReference Include="Xamarin.AndroidX.Wear" Version="1.4.0.2" />
        <PackageReference Include="Xamarin.AndroidX.Wear.Tiles" Version="1.6.2" />
        <PackageReference Include="Xamarin.AndroidX.Wear.Tiles.Material" Version="1.6.2" />
        <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
        <PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.2" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Stratum.Droid.Shared\Stratum.Droid.Shared.csproj" />
        <ProjectReference Include="..\Stratum.Core\Stratum.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <ProguardConfiguration Include="proguard.cfg" />
    </ItemGroup>
    <ItemGroup>
        <LinkDescription Include="trim.xml" />
    </ItemGroup>
</Project>